# election-cos-app environment — copy to .env and fill in for local dev.
# See docs/phase-0-infra-plan.md for how these are provisioned (source:
# 03-implementation-rollout-plan.md). Project IDs are decided
# (innovation-consult-ecos-dev / -prod) — nothing is provisioned yet.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 'firestore' (default, Phase 0-7) | 'postgres' (Phase 8, first paying customer only)
VITE_DAL_ADAPTER=firestore

# Reference — not read by the app, just so the intended prod values are in
# one place: prod project id innovation-consult-ecos-prod, app domain
# app.electioncampaignos.co.za, API domain api.electioncampaignos.co.za.
