# election-cos-app environment — copy to .env and fill in for local dev.
# Real project confirmed session 10: election2026-campaignms7-0 (see
# .firebaserc and BUILD-STATUS.md). Values below still have to come from
# that project's own web app registration (Firebase Console → Project
# Settings → General → Your apps → Web app → SDK setup and configuration)
# — no CLI/API credentials are available in the build environment to
# register the app or read these values automatically. VITE_FIREBASE_APP_ID
# in particular only exists after a web app has been registered.

VITE_FIREBASE_API_KEY=

# VITE_FIREBASE_AUTH_DOMAIN — read the ordering before changing this.
#
# Use the value the console gives you:
#   election2026-campaignms7-0.firebaseapp.com
#
# The registered application domain is electioscos.co.za, and pointing
# authDomain at it is a legitimate and better end state — a party official
# signing in then sees the campaign's own domain rather than a
# firebaseapp.com host. It serves the OAuth handshake from /__/auth/*,
# which Firebase Hosting provides on a custom domain too.
#
# But it only works AFTER electioscos.co.za is connected to Hosting on
# this project, its certificate is issued, and it is listed under
# Authentication -> Settings -> Authorised domains. Set it before that and
# EVERY sign-in fails — which is the one failure that locks out the people
# who would otherwise fix it. `npm run preflight` warns if this is set to
# anything other than the Firebase default.
VITE_FIREBASE_AUTH_DOMAIN=

VITE_FIREBASE_PROJECT_ID=election2026-campaignms7-0
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 'firestore' (default, Phase 0-7) | 'postgres' (Phase 8, first paying customer only)
VITE_DAL_ADAPTER=firestore

# Google Maps Platform — household geocoding map (src/modules/voters/HouseholdMap).
# Optional: the app runs fully without this, the map view just shows a
# "not configured" message instead of a blank/broken map. Get a key from
# Google Cloud Console (Maps JavaScript API + Geocoding API enabled),
# restrict it to this app's domain(s) before using it anywhere but local
# dev. Never commit a real key — this file only holds the variable name.
VITE_GOOGLE_MAPS_API_KEY=
# Optional — only needed for custom map styling; Advanced Markers render
# without it. Create one in Cloud Console → Maps Platform → Map Management.
VITE_GOOGLE_MAPS_MAP_ID=

# Domain plan (docs/phase-0-infra-plan.md) — not read by the app, kept here
# for reference: app domain app.electioncampaignos.co.za, API domain
# api.electioncampaignos.co.za. Not reconciled against whether this
# project has custom domains configured yet.
