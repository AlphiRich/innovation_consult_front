{
  "name": "@innovation-consult/ecos-app",
  "private": true,
  "version": "1.0.0-dev",
  "type": "module",
  "description": "Election Campaign OS \u2014 application shell (election-cos-app). IC-ECOS-BUILD-2026-V2.",
  "scripts": {
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "check:all": "npm run lint && npm run typecheck && npm run check:hex && npm run check:type-scale && npm run check:headers && npm run check:fonts && npm run test",
    "check:fonts": "node tools/fonts/vendor-fonts.mjs --check",
    "check:headers": "node scripts/sync-hosting-headers.mjs --check",
    "check:hex": "node scripts/check-no-hex.mjs",
    "check:type-scale": "node scripts/check-type-scale.mjs",
    "deploy": "npm run check:all && npm run build && npm run preflight && firebase deploy --project default",
    "deploy:functions": "npm run preflight && firebase deploy --only functions --project default",
    "deploy:hosting": "npm run build && npm run preflight && firebase deploy --only hosting --project default",
    "deploy:rules": "npm run preflight && firebase deploy --only firestore:rules,storage --project default",
    "dev": "vite",
    "docs:emit": "vite-node scripts/emit-documents.ts --",
    "emulators": "firebase emulators:start --project demo-ecos",
    "gen:roles": "vite-node scripts/gen-roles.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preflight": "node scripts/deploy-preflight.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@vis.gl/react-google-maps": "^1.10.0",
    "dexie": "^4.0.8",
    "firebase": "^10.13.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "fake-indexeddb": "^6.0.0",
    "fast-check": "^3.22.0",
    "firebase-tools": "^15.34.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^2.0.5"
  }
}
