# ecos-app environment — copy to .env and fill in for local dev.
# See 03-implementation-rollout-plan-v2.md for how these are provisioned.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 'firestore' (default, Phase 0-7) | 'postgres' (Phase 8, first paying customer only)
VITE_DAL_ADAPTER=firestore
